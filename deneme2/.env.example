# Database - Railway PostgreSQL plugin otomatik sağlar
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ui_benchmarks?schema=public"

# AI Providers
ANTHROPIC_API_KEY="sk-ant-..."
AI_PROVIDER="claude"
AI_MODEL="claude-sonnet-4-20250514"

# Storage
STORAGE_PROVIDER="local"
# Local dev: ./public/uploads | Railway: /app/data/uploads
UPLOAD_DIR="./public/uploads"

# App
# Railway'de otomatik atanır: https://your-app.up.railway.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_KEY="your-internal-api-key"

# Auth (kullanici:sifre,kullanici2:sifre2) ve oturum imzası
APP_USERS="admin:change-me"
AUTH_SECRET="uzun-rastgele-bir-deger"

# Yalnızca yerel makinede kurulu Chromium, package.json'daki Playwright
# sürümüyle eşleşmiyorsa. Docker imajında tanımlamayın.
# CHROMIUM_EXECUTABLE_PATH="/path/to/chromium"
